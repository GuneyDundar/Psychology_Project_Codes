#(Block 1 - Break routine 1) Loop 1
#Block 1

#>Begin experiment

import numpy as np
import random

trial_num = 0

# Article-accurate RGB spectrum
# R: 100 down to 1
R_values = np.arange(100, 0, -1)   # 100, 99, ..., 1

# B always equals 255 - R
B_values = 255 - R_values          # ensures R + B = 255

# G is always 0 (constant, so no need for array)

#>Begin routine

trial_num += 1

if random.random() < 0.5:
    # Blue spectrum: R = 1–50
    r = random.randint(1, 50)
    spectrum = "blue"
else:
    # Purple spectrum: R = 51–100
    r = random.randint(51, 100)
    spectrum = "purple"

# Enforce article rule: R + B = 255
b = 255 - r
g = 0

dot_1.setColor([r, g, b], colorSpace='rgb255')

#>End routine

thisExp.addData('trial_num', trial_num)
thisExp.addData('r_value', r)
thisExp.addData('g_value', g)
thisExp.addData('b_value', b)
thisExp.addData('spectrum_sampled', spectrum)

#Break routine 1

if (trial_num % 50) !=0:
    continueRoutine = False

#Loop 1 = Loop type: Random / is trials: yes / Number of repeats: 200

